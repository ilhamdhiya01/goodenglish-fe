# Base URL for the goodenglish backend API.
#
# NEXT_PUBLIC_* is inlined into the client bundle during `next build` — it is
# NOT read at runtime. Production uses a relative path: FE and BE share the
# domain goodenglish.my.id behind nginx (/api/v1 → backend), so requests stay
# same-origin and the session cookie reaches both.
#
#   production: /api/v1
#   local dev:  http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
