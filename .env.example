# Base URL for the goodenglish backend API.
#
# NEXT_PUBLIC_* is inlined into the client bundle during `next build` — it is
# NOT read at runtime. Production uses a relative path: FE and BE share the
# domain goodenglish.my.id behind nginx (/api/v1 → backend), so requests stay
# same-origin and the session cookie reaches both.
#
#   production: /api/v1
#   local dev:  /api/v1 with DEV_API_PROXY below (same origin, like
#               production), or http://localhost:3001/api/v1 without it
NEXT_PUBLIC_API_URL=/api/v1

# Dev only (next.config.ts). Forwards /api/v1 to the backend so the app has
# one origin, like behind nginx in production.
DEV_API_PROXY=http://localhost:3001
# Dev only. Extra hosts that may open `next dev`, comma-separated, e.g. this
# machine's LAN IP to test on a phone (http://<ip>:3002). Without it Next
# blocks its dev scripts for that host and the page never becomes interactive.
# DEV_ALLOWED_ORIGINS=192.168.1.10
